# Server .env example

# Stripe secret key (server)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe publishable key (client) - used in confession-room.html
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Stripe Price IDs (create these in your Stripe dashboard)
PRICE_MONTHLY_ID=price_1ExampleMonthly
PRICE_SINGLE_ID=price_1ExampleSingle

# Checkout redirect URLs (your deployed site)
SUCCESS_URL=https://your-site.example/confession-room.html
CANCEL_URL=https://your-site.example/confession-room.html

# Stripe webhook secret (from stripe CLI or dashboard)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Server port (optional)
PORT=3000
